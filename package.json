{
  "name": "my-nest-project",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --watch --entryFile worker",
    "repl": "nest start --entryFile repl",
    "cs:repl": "node --import @swc-node/register/esm-register scripts/customer-support-repl.ts",
    "f9:repl": "node --import @swc-node/register/esm-register scripts/form9-repl.ts",
    "coding:repl": "node --import @swc-node/register/esm-register scripts/coding-agent-repl.ts",
    "leaves:eval": "DEEPEVAL_TELEMETRY_OPT_OUT=1 DEEPEVAL_DISABLE_DOTENV=1 DEEPEVAL_EVAL_MODE=llm deepeval test run src/modules/leave-tracker/evals",
    "lint": "oxlint --type-aware src/ test/ scripts/",
    "test": "vitest run --exclude 'src/**/*.eval.ts'",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.154",
    "@ai-sdk/harness-pi": "1.0.156",
    "@ai-sdk/mcp": "2.0.78",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@chat-adapter/slack": "4.43.0",
    "@chat-adapter/state-redis": "4.43.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-fastify": "^12.2.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "7.0.143",
    "axios": "^1.20.0",
    "bullmq": "^5.80.2",
    "chat": "4.43.0",
    "dotenv": "^18.0.9",
    "fastify": "5.12.7",
    "html-to-text": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "deepeval": "0.9.22",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "msgpackr-extract",
      "prisma"
    ],
    "patchedDependencies": {
      "deepeval@0.9.22": "patches/deepeval@0.9.22.patch"
    }
  }
}
